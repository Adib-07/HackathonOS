# Required runtime environment variables.
# Copy to .env for local development. Never commit a filled-in .env.

# --- Database (required in every environment) ---
# PostgreSQL connection string.
# Production must set this explicitly; the server refuses to start without it.
DATABASE_URL="postgresql://localhost:5432/hackathon_os"

# --- Clerk (required for authenticated access) ---
# Backend secret key. Signs and verifies session tokens.
CLERK_SECRET_KEY=""
# Backend publishable key, used to resolve the right Clerk instance per host.
CLERK_PUBLISHABLE_KEY=""
# Frontend publishable key, read by the web app at build time.
VITE_CLERK_PUBLISHABLE_KEY=""

# --- Web app (required at build time) ---
# Base path the web app is served from.
BASE_PATH="/"
# Port the web dev server and preview server listen on.
PORT=19678

# --- Optional ---
# Set to the app's own origin + "/api/__clerk" to proxy Clerk through the API.
# Leave unset in local development so Clerk uses its own hosted flow.
VITE_CLERK_PROXY_URL=""
# Log level for the API server (default: info).
LOG_LEVEL="info"

# --- AI provider (optional) ---
# The research and idea engine works without these. The problem analysis,
# research, gap analysis, scoring rubric, and build brief all run from stored
# data. Only the generative steps (extra requirements, idea generation,
# model-proposed scores, and a model-written brief) need a provider.
#
# The key is read on the server only. It is never sent to the browser, never
# logged, and never included in an error response.
OPENAI_API_KEY=""
# Optional. Override for an OpenAI-compatible gateway or a self-hosted
# deployment. Defaults to the public OpenAI endpoint.
OPENAI_BASE_URL=""
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=""
