{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "regions": ["iad1"],
  "functions": {
    "artifacts/api-server/dist/app.mjs": {
      "maxDuration": 30,
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/artifacts/api-server/dist/app.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/artifacts/hackathon-os/dist/public/$1"
    }
  ],
  "outputDirectory": "artifacts/hackathon-os/dist/public",
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  }
}